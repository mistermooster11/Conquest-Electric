@media (min-width: 500px) and (max-width: 1220px) {

    /* Main slider mask */
    sr7-mask.slider-width {
        width: 100vw !important;       /* full viewport width */
        max-width: 100vw !important;
        left: 0 !important;            /* remove centering hacks */
        transform: none !important;    /* reset transform */
			padding-left:60px;
			padding-right:60px;
    }

    /* Inner group container inside mask */
    sr7-mask.slider-width sr7-grp {
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Heading and top text layers */
    sr7-mask.slider-width .heading-top,
    sr7-mask.slider-width .top-text {
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Force all child layers to respect full width */
    sr7-mask.slider-width *,
    sr7-mask.slider-width *::before,
    sr7-mask.slider-width *::after {
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Optional: make canvas/background fit full width */
    sr7-mask.slider-width sr7-bg canvas {
        width: 100% !important;
        max-width: 100% !important;
    }

}

